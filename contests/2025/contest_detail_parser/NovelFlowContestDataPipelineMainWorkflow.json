{
  "Comment": "Main workflow to orchestrate the daily collection of contest novel data using a Fan-Out pattern with a dynamic completion check.",
  "StartAt": "PurgeTaskQueue",
  "States": {
    "PurgeTaskQueue": {
      "Type": "Task",
      "Comment": "Clears leftovers from previous runs. Must be followed by WaitForPurgeToFinish (see below).",
      "Resource": "arn:aws:states:::aws-sdk:sqs:purgeQueue",
      "Parameters": {
        "QueueUrl": "https://sqs.YOUR_AWS_REGION.amazonaws.com/YOUR_AWS_ACCOUNT_ID/np-trend-contest-task-queue-2025"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 65,
          "MaxAttempts": 2,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ],
      "Next": "PurgeResultQueue"
    },
    "PurgeResultQueue": {
      "Type": "Task",
      "Comment": "Result messages carry no execution_id, so stale results would be counted as today's.",
      "Resource": "arn:aws:states:::aws-sdk:sqs:purgeQueue",
      "Parameters": {
        "QueueUrl": "https://sqs.YOUR_AWS_REGION.amazonaws.com/YOUR_AWS_ACCOUNT_ID/np-trend-contest-result-queue-2025"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 65,
          "MaxAttempts": 2,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ],
      "Next": "WaitForPurgeToFinish"
    },
    "WaitForPurgeToFinish": {
      "Type": "Wait",
      "Comment": "PurgeQueue takes up to 60s and may delete messages sent while it runs (AWS recommends waiting 60s). Sending right after the purge lost 599 tasks on 2026-09-11.",
      "Seconds": 65,
      "Next": "FanOutTasksToSQS"
    },
    "FanOutTasksToSQS": {
      "Type": "Task",
      "Comment": "Reads novel IDs from S3 and sends them as individual messages to a Task SQS Queue.",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:np-trend-contest-get-id-list",
      "Parameters": {
        "execution_id.$": "$$.Execution.Name",
        "date.$": "$$.State.EnteredTime"
      },
      "ResultPath": "$.FanOutResult",
      "Next": "CheckIfDone",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ]
    },
    "CheckIfDone": {
      "Type": "Task",
      "Comment": "Checks if the number of messages in the Result Queue matches the number of fanned-out tasks. Retried because one transient Lambda error here would otherwise fail the run and the collected results would be purged the next day. Safe to re-run: it only peeks at the result queue and restores visibility.",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:np-trend-contest-check-completion",
      "Parameters": {
        "execution_id.$": "$$.Execution.Name",
        "fanned_out_count.$": "$.FanOutResult.fanned_out_count"
      },
      "ResultPath": "$.CompletionCheck",
      "Next": "IsParsingComplete?",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 15,
          "MaxAttempts": 4,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ]
    },
    "IsParsingComplete?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.CompletionCheck.is_done",
          "BooleanEquals": true,
          "Next": "ConsolidateContestData"
        }
      ],
      "Default": "WaitForNextCheck"
    },
    "WaitForNextCheck": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckIfDone"
    },
    "ConsolidateContestData": {
      "Type": "Task",
      "Comment": "Collects all messages from the Result SQS Queue, calculates metrics, and saves to DynamoDB.",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:np-trend-contest-consolidate-data",
      "Parameters": {
        "execution_id.$": "$$.Execution.Name",
        "fanned_out_count.$": "$.FanOutResult.fanned_out_count"
      },
      "Next": "PipelineSuccess",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 90,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ]
    },
    "PipelineFail": {
      "Type": "Fail",
      "Comment": "The entire data collection process failed."
    },
    "PipelineSuccess": {
      "Type": "Succeed",
      "Comment": "The data collection process completed successfully."
    }
  },
  "TimeoutSeconds": 1200
}