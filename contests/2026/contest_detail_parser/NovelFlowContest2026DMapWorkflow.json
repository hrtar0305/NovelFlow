{
  "Comment": "2026 공모전 수집 — Distributed Map 판. 실패를 가정한다: ID 수집 실패·지연(실행 시작 12분 뒤로는 다시 부르지 않음)은 직전 목록으로 진행, 작품 실패는 묶음 안에 가두고 빠진 것만 다시 받으며(최대 2라운드), 남은 결손은 placeholder + 실패 장부(failures/{date}.json) + 경고 알림. 결손이 5%를 넘으면 쓰지 않고 실패. 그림자 실행: {\"skip_discovery\": true, \"raw\": false, \"dry_run\": true, \"target_date\": \"YYYY-MM-DD\"}. 재시도 경로 시험: 그림자 실행에 \"inject_fail_mod\": N 을 주면 첫 라운드에서 번호 % N == 0 인 작품을 네트워크 실패로 친다(dry_run 일 때만). 예약 실행은 날짜 잠금(RUN_LOCK#{date})을 잡아 중복 전달을 건너뛴다 — 같은 날짜를 입력 없이 다시 돌리려면 잠금 항목을 지우거나 target_date 를 준다.",
  "StartAt": "Defaults",
  "TimeoutSeconds": 2700,
  "States": {
    "Defaults": {
      "Type": "Pass",
      "Parameters": {
        "args.$": "States.JsonMerge(States.StringToJson('{\"target_date\": \"\", \"skip_discovery\": false, \"raw\": true, \"dry_run\": false, \"inject_fail_mod\": 0}'), $$.Execution.Input, false)",
        "Discover": {
          "done": true,
          "fallback": false,
          "skipped": true,
          "total_contest": null,
          "listed_total": null,
          "alive_contest": null
        },
        "DiscoverRounds": {
          "n": 0
        }
      },
      "Next": "ResolveDate"
    },
    "SkipDiscovery?": {
      "Type": "Choice",
      "Comment": "그림자 실행은 운영 수집기 상태(S3)를 건드리지 않도록 건너뛴다.",
      "Choices": [
        {
          "Variable": "$.args.skip_discovery",
          "BooleanEquals": true,
          "Next": "FirstRound"
        }
      ],
      "Default": "DiscoverIds"
    },
    "DiscoverIds": {
      "Type": "Task",
      "Comment": "수집기 응답(done·total_contest·alive_contest·listed_total…)을 통째로 $.Discover 에 둔다. ResultSelector 로 필드를 고르면 수집기·상태 머신 배포 순서가 어긋날 때(새 필드가 없는 옛 수집기) 경로 오류로 자정 실행이 실패했다(최종 검증 2026-10-03).",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-contest-2026-id-collector",
      "Parameters": {
        "execution_id.$": "$$.Execution.Name"
      },
      "ResultPath": "$.Discover",
      "TimeoutSeconds": 900,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.DiscoverError",
          "Next": "WaitAfterDiscoverError"
        }
      ],
      "Next": "IsDiscoveryDone?"
    },
    "IsDiscoveryDone?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Discover.done",
          "BooleanEquals": true,
          "Next": "FirstRound"
        }
      ],
      "Default": "DiscoverAgain?"
    },
    "WaitAfterDiscoverError": {
      "Type": "Wait",
      "Comment": "수집기 실패 뒤 순간 장애를 넘길 시간.",
      "Seconds": 30,
      "Next": "DiscoverAgain?"
    },
    "DiscoverAgain?": {
      "Type": "Choice",
      "Comment": "수집기를 다시 부를지 — 횟수가 아니라 시각으로 끊는다. 호출 하나가 최대 15분이라 횟수(예전 4번)로는 45분 실행 제한 안에 대체 경로에 닿지 못했다. ResolveDate 가 정한 마감(실행 시작 + 12분, 팬아웃 DISCOVERY_RECALL_MINUTES)이 지났으면 직전 목록으로 진행 — 수집 단계는 최악 27분에 끝난다. 마감이 없는 입력(옛 팬아웃)이면 횟수만 본다.",
      "Choices": [
        {
          "Variable": "$.DiscoverRounds.n",
          "NumericGreaterThanEquals": 4,
          "Next": "DiscoveryFallback"
        },
        {
          "Not": {
            "Variable": "$.Resolved.discovery_deadline",
            "IsPresent": true
          },
          "Next": "CountDiscoverRound"
        },
        {
          "Variable": "$$.State.EnteredTime",
          "TimestampGreaterThanEqualsPath": "$.Resolved.discovery_deadline",
          "Next": "DiscoveryFallback"
        }
      ],
      "Default": "CountDiscoverRound"
    },
    "CountDiscoverRound": {
      "Type": "Pass",
      "Comment": "수집기를 다시 부른다(시간 예산으로 끊겼거나 실패). 언제 멈출지는 DiscoverAgain? 가 시각으로 정하고, 횟수(4번)는 마지막 안전장치다.",
      "Parameters": {
        "n.$": "States.MathAdd($.DiscoverRounds.n, 1)"
      },
      "ResultPath": "$.DiscoverRounds",
      "Next": "DiscoverIds"
    },
    "DiscoveryFallback": {
      "Type": "Pass",
      "Comment": "ID 수집은 부가 단계다 — 실패해도 S3 에 남은 직전 목록(23:30 준비 실행 등)으로 그날 수집을 한다. 장부·알림에 남는다.",
      "Result": {
        "done": true,
        "fallback": true,
        "skipped": false,
        "total_contest": null,
        "listed_total": null,
        "alive_contest": null
      },
      "ResultPath": "$.Discover",
      "Next": "FirstRound"
    },
    "ResolveDate": {
      "Type": "Task",
      "Comment": "기록 날짜(실행 시작 − 12시간, 또는 target_date). 팬아웃 함수의 같은 규칙을 쓴다.",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-contest-2026-fanout",
      "Parameters": {
        "resolve_only": true,
        "execution_id.$": "$$.Execution.Name",
        "date.$": "$$.Execution.StartTime",
        "target_date.$": "$.args.target_date"
      },
      "ResultPath": "$.Resolved",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ],
      "Next": "Scheduled?"
    },
    "Scheduled?": {
      "Type": "Choice",
      "Comment": "예약 실행(입력 없음)만 날짜 잠금을 건다. target_date 재실행·그림자 실행은 일부러 같은 날짜를 다시 도는 것이라 막지 않는다.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.args.target_date",
              "StringEquals": ""
            },
            {
              "Variable": "$.args.dry_run",
              "BooleanEquals": false
            }
          ],
          "Next": "AcquireRunLock"
        }
      ],
      "Default": "SkipDiscovery?"
    },
    "AcquireRunLock": {
      "Type": "Task",
      "Comment": "스케줄러는 at-least-once 라 같은 예약이 두 번 전달될 수 있다. 날짜당 한 실행만 잠금을 잡고, 늦게 온 쪽은 아무것도 하지 않고 끝난다. 잠금 항목은 View 가 없어 DateViewIndex 에 들어가지 않는다.",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "NovelFlowContest2026",
        "Item": {
          "ID": {
            "S.$": "States.Format('RUN_LOCK#{}', $.Resolved.date)"
          },
          "Date": {
            "S": "LOCK"
          },
          "ExecutionArn": {
            "S.$": "$$.Execution.Id"
          },
          "StartedAt": {
            "S.$": "$$.Execution.StartTime"
          }
        },
        "ConditionExpression": "attribute_not_exists(ID)"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.InternalServerErrorException",
            "DynamoDB.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "ResultPath": "$.LockError",
          "Next": "NotifyDuplicateRun"
        }
      ],
      "Next": "SkipDiscovery?"
    },
    "NotifyDuplicateRun": {
      "Type": "Task",
      "Comment": "중복 전달을 알리고(멘션 없음) 끝낸다. 실패로 두면 멘션 알림이 울려 진짜 실패와 섞인다.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-discord-notify",
        "InvocationType": "Event",
        "Payload": {
          "content.$": "States.Format('2026 공모전 {} 수집: 같은 날짜의 예약 실행이 이미 있어 이 실행({})은 건너뛰었습니다.', $.Resolved.date, $$.Execution.Name)",
          "mention": false
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "DuplicateSkipped"
        }
      ],
      "Next": "DuplicateSkipped"
    },
    "DuplicateSkipped": {
      "Type": "Succeed"
    },
    "FirstRound": {
      "Type": "Pass",
      "Comment": "첫 라운드: 전체 목록, 20편 묶음, 동시 10. 묶음은 EXPRESS 자식(최대 5분) 안에 끝나야 한다 — 처리량은 동시 수가 정하고 묶음 크기는 자식 하나의 소요만 정하므로 줄여도 느려지지 않는다(파서 시간 예산 170초 + ParseBatch 280초 제한).",
      "Result": {
        "round": 0,
        "missing_key": "contest_novel_ids_2026.json",
        "batch": 20,
        "concurrency": 10
      },
      "ResultPath": "$.Work",
      "Next": "ParseMap"
    },
    "ParseMap": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Parameters": {
          "Bucket": "novelflow-contest-2026-YOUR_AWS_ACCOUNT_ID",
          "Key.$": "$.Work.missing_key"
        }
      },
      "ItemBatcher": {
        "MaxItemsPerBatchPath": "$.Work.batch",
        "BatchInput": {
          "execution_id.$": "$$.Execution.Name",
          "date.$": "$.Resolved.date",
          "raw.$": "$.args.raw",
          "round.$": "$.Work.round",
          "dry_run.$": "$.args.dry_run",
          "inject_fail_mod.$": "$.args.inject_fail_mod"
        }
      },
      "MaxConcurrencyPath": "$.Work.concurrency",
      "ToleratedFailurePercentage": 100,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "EXPRESS"
        },
        "StartAt": "ParseBatch",
        "States": {
          "ParseBatch": {
            "Type": "Task",
            "Comment": "EXPRESS 자식은 최대 5분이다. 파서가 시간 예산(170초)을 넘기면 남은 작품을 failed(TimeBudget)로 돌려주고, 이 단계는 280초에서 끊는다. 자식 안에서는 호출 직후 나는 Lambda 서비스 오류만 다시 부른다 — 오래 돈 뒤의 실패(TaskFailed·Unknown·Timeout)를 다시 돌리면 5분을 넘겨 받은 것까지 버린다. 그런 묶음은 Reconcile 이 빠진 작품만 다시 받는다.",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-contest-2026-parser-dmap",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "TimeoutSeconds": 280,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.TooManyRequestsException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Parameters": {
          "Bucket": "novelflow-contest-2026-YOUR_AWS_ACCOUNT_ID",
          "Prefix": "dmap-results"
        }
      },
      "ResultSelector": {
        "manifest.$": "$.ResultWriterDetails"
      },
      "ResultPath": "$.Map",
      "Comment": "실패한 묶음이 있어도 Map 은 끝까지 간다(허용 100%) — 무엇이 빠졌는지는 Reconcile 이 기대 목록과 견줘 정한다.",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ],
      "Next": "Reconcile"
    },
    "Reconcile": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-contest-2026-consolidate-dmap",
      "Parameters": {
        "action": "reconcile",
        "execution_id.$": "$$.Execution.Name",
        "date.$": "$.Resolved.date",
        "round.$": "$.Work.round",
        "manifest.$": "$.Map.manifest"
      },
      "ResultPath": "$.Rec",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 15,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ],
      "Next": "RetryMissing?"
    },
    "RetryMissing?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Rec.retry",
          "BooleanEquals": true,
          "Next": "WaitBeforeRetry"
        }
      ],
      "Default": "Consolidate"
    },
    "WaitBeforeRetry": {
      "Type": "Wait",
      "SecondsPath": "$.Rec.wait_seconds",
      "Next": "NextRound"
    },
    "NextRound": {
      "Type": "Pass",
      "Comment": "빠진 작품만, 작게(10편) 천천히(동시 3) 다시 받는다.",
      "InputPath": "$.Rec",
      "ResultPath": "$.Work",
      "Next": "ParseMap"
    },
    "Consolidate": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-contest-2026-consolidate-dmap",
      "Parameters": {
        "execution_id.$": "$$.Execution.Name",
        "date.$": "$.Resolved.date",
        "dry_run.$": "$.args.dry_run",
        "discover.$": "$.Discover"
      },
      "ResultPath": "$.Result",
      "Retry": [
        {
          "ErrorEquals": [
            "TooManyMissing"
          ],
          "MaxAttempts": 0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFail"
        }
      ],
      "Next": "Degraded?"
    },
    "Degraded?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Result.degraded",
          "BooleanEquals": true,
          "Next": "NotifyDegraded"
        }
      ],
      "Default": "PipelineSuccess"
    },
    "NotifyDegraded": {
      "Type": "Task",
      "Comment": "적재는 했지만 결손이 있다 — 실패 알림(멘션)과 구분해 멘션 없이 알린다. 알림 실패가 수집을 실패로 만들지 않는다.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:function:novelflow-discord-notify",
        "InvocationType": "Event",
        "Payload": {
          "content.$": "$.Result.notice",
          "mention": false
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "PipelineSuccess"
        }
      ],
      "Next": "PipelineSuccess"
    },
    "PipelineFail": {
      "Type": "Fail"
    },
    "PipelineSuccess": {
      "Type": "Succeed"
    }
  }
}
