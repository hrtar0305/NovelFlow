# =============================================================================
# NovelFlow 프론트엔드 (Vite/React) 환경변수 예시
# Vite 규칙상 VITE_ 접두사 변수만 클라이언트 번들에 노출됩니다.
#   - VITE_API_BASE_URL : 개발은 .env.development, 배포는 .env.production 에 설정
#   - Algolia 키        : .env 에 설정 (Search-Only 키는 공개돼도 안전)
# =============================================================================

# 백엔드 API 베이스 URL
VITE_API_BASE_URL=http://localhost:8000

# Algolia 검색 (소설/작가 검색창)
VITE_ALGOLIA_APP_ID=your_algolia_app_id
VITE_ALGOLIA_SEARCH_API_KEY=your_search_only_api_key
