# 2025 공모전 수상 트랙별 노벨피아 소설 ID 목록 (쉼표 구분, 예: 123456,234567)
# 소설 상세/공모전 페이지에 수상 배지를 표시하는 데 사용됩니다.
GRAND_PRIZE_IDS_2025=
TOP_EXCELLENCE_AWARD_IDS_2025=
TOPTOON_AWARD_IDS_2025=
WINNER_AWARD_IDS_2025=
SPECIAL_AWARD_IDS_2025=
