# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments - Common names
venv/
.venv/
env/
.env/

# Distribution / packaging
*.egg-info/
dist/
build/


# =============================================================================
# Project-specific
# =============================================================================

# AWS Lambda dependency packages
data-pipeline/package/
webapp/backend/package/

# Local data files
data/

# Deployment artifacts
*.zip

# Gemini context file
GEMINI.md

# Custom ignores
todo.md

# =============================================================================
# Web Frontend (Node.js / Vite / React)
# =============================================================================

# Dependencies
webapp/frontend/node_modules/

# Environment variables - IMPORTANT: Never commit secrets
webapp/frontend/.env
webapp/frontend/.env.*
!webapp/frontend/.env.example

# Build output
webapp/frontend/dist/

# Vite cache
webapp/frontend/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# =============================================================================
# General
# =============================================================================

# IDE / Editor configuration
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db